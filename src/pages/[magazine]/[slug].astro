---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Heading from '../../components/Heading.astro';
import { getCollection, getEntry } from 'astro:content';
import { formatMagazineDate } from '../../utils/date';

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

export async function getStaticPaths() {
  return [
    { params: { magazine: 'zgjjjc', slug: '202501' } },
    { params: { magazine: 'zgjjjc', slug: '202607' } },
    { params: { magazine: 'zgjjjc', slug: '202614' } },
    { params: { magazine: 'cpaj', slug: '202607' } },
  ];
}

const { magazine, slug } = Astro.params;

// const year = Number(slug.slice(0, 4));
// const issueNo = Number(slug.slice(4));
// const title = `${year}年第${issueNo}期`;

const data = (await getEntry('zgjjjcs', slug))?.data;
if (!data) return;

const title = `${data?.year}年第${data?.issueNo}期`;

const publishDate = data?.publishDate
  ? formatMagazineDate(data?.publishDate)
  : '';

const sections = data.sections ?? [];

const headings: MarkdownHeading[] =
  sections?.map((section) => ({
    depth: 2,
    slug: section.title,
    text: section.title,
  })) ?? [];
---

<StarlightPage frontmatter={{ title }} {headings}>
  <div class='magazine-toc'>
    <div class='toc-header'>
      <p>
        {title} | 总第{data.volumeNo}期 |{' '}
        {publishDate}出版
      </p>
    </div>

    <section>
      {
        sections &&
          sections.map((section) => (
            <div>
              <Heading text={section.title} level={3}>
                {section.title}
              </Heading>

              {section.subTitle && (
                <p class='toc-subtitle'>{section.subTitle}</p>
              )}

              {(section.items ?? []).map((item) => (
                <div class='toc-item'>
                  <span>{item.page}</span>

                  <p>{item.title}</p>

                  <em>{item.author}</em>
                </div>
              ))}
            </div>
          ))
      }
    </section>
  </div>
</StarlightPage>
