---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Heading from '../../components/Heading.astro';
import { getEntry } from 'astro:content';
import { formatMagazineDate } from '../../utils/date';
import { getCollection } from 'astro:content';

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

export async function getStaticPaths() {
  const zgjjjcEntries = await getCollection('zgjjjcs');
  const cpajEntries = await getCollection('cpajs');

  return [
    ...zgjjjcEntries.map((entry) => ({
      params: {
        magazine: 'zgjjjc',
        slug: entry.id,
      },
      cacheKey: String(entry.data.sections),
    })),
    ...cpajEntries.map((entry) => ({
      params: {
        magazine: 'cpaj',
        slug: entry.id,
      },
      cacheKey: String(entry.data.sections),
    })),
  ];
}

const { magazine, slug } = Astro.params;

const collectionName =
  magazine === 'zgjjjc' ? 'zgjjjcs' : magazine === 'cpaj' ? 'cpajs' : null;

if (!collectionName || !slug) return;

const entry = await getEntry(collectionName, slug);
const data = entry?.data;
if (!entry || !data) return;

const title = `${data?.year}年第${data?.issueNo}期`;

const publishDate = data?.publishDate
  ? formatMagazineDate(data?.publishDate)
  : '';

const sections = data.sections ?? [];

const headings: MarkdownHeading[] =
  sections?.map((section) => ({
    depth: 2,
    slug: section.title,
    text: section.title,
  })) ?? [];
---

<StarlightPage frontmatter={{ title }} {headings}>
  <div class='magazine-toc'>
    <div class='toc-header'>
      <p>
        {title} | 总第{data.volumeNo}期 |{' '}
        {publishDate}出版
      </p>
    </div>

    <section>
      {
        sections &&
          sections.map((section) => (
            <div>
              <Heading text={section.title} level={3}>
                {section.title}
              </Heading>

              {section.subTitle && (
                <p class='toc-subtitle'>{section.subTitle}</p>
              )}

              {(section.items ?? []).map((item) => (
                <div class='toc-item'>
                  <span>{item.page}</span>

                  <p>{item.title}</p>

                  <em>{item.author}</em>
                </div>
              ))}
            </div>
          ))
      }
    </section>
  </div>
</StarlightPage>
