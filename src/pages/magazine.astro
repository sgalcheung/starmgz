---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { formatMagazineDate } from '../utils/date';
import Heading from '../components/Heading.astro';
import { getCollection, getEntries, type CollectionEntry } from 'astro:content';
import type { StarlightUserConfig } from '@astrojs/starlight/types';
import AuthorName from '../components/AuthorName.astro';

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

const docs = await getCollection(
  'docs',
  ({ data }) => data.template !== 'splash',
);

const mdPath = 'markdownpage/dynamic';

const magazineDoc = docs.find((doc) => doc.id === mdPath);
if (!magazineDoc) return;

const data = magazineDoc?.data;
const publishDate = data?.publishDate
  ? formatMagazineDate(data?.publishDate)
  : '';

const sections = data.sections ?? [];

const headings: MarkdownHeading[] =
  sections?.map((section) => ({
    depth: 2,
    slug: section.title,
    text: section.title,
  })) ?? [];

const frontmatter = { title: data.title, type: undefined };

function groupDocs(docs: CollectionEntry<'docs'>[]) {
  const groups = new Map<string, CollectionEntry<'docs'>[]>();

  for (const doc of docs) {
    const key = doc.filePath?.split('/')[3] ?? '_root';

    let items = groups.get(key);

    if (!items) {
      items = [];
      groups.set(key, items);
    }

    items.push(doc);
  }

  return groups;
}

function capitalize(str: string): string {
  if (!str) return str;
  return str.charAt(0).toUpperCase() + str.slice(1);
}

function renderSidebar(
  docs: CollectionEntry<'docs'>[],
): NonNullable<StarlightUserConfig['sidebar']> {
  const groups = groupDocs(docs);

  const sidebar = [...groups.entries()]
    .map(([groupKey, items]) => {
      if (groupKey === '_root') {
        return items.map((doc) => ({
          label: doc.data.sidebar?.label ?? doc.data.title,
          slug: doc.id,
        }));
      }

      return {
        label: capitalize(groupKey),
        collapsed: false,
        items: items.map((doc) => ({
          label: doc.data.sidebar?.label ?? doc.data.title,
          slug: doc.id,
        })),
      };
    })
    .flat();

  return [
    ...sidebar,
    {
      label: 'StarlightPage',
      items: [
        {
          label: '2026年第14期',
          link: '/magazine/',
        },
      ],
    },
  ];
}

const sidebar = renderSidebar(docs);
---

<StarlightPage {frontmatter} {headings} {sidebar}>
  <div class='magazine-toc'>
    <div class='toc-header'>
      <p>
        2026年第{data.issueNo}期 | 总第{data.volumeNo}期 |{' '}
        {publishDate}出版
      </p>
    </div>

    <section>
      {
        sections.map((section) => (
          <div>
            <Heading text={section.title} level={3}>
              {section.title}
            </Heading>

            {section.subTitle && (
              <p class='toc-subtitle'>{section.subTitle}</p>
            )}

          {section.items.map(async (item) => {
                const authorEntries = await getEntries(item.authors);

              return (
                <div class="toc-item">
                  <span>{item.page}</span>
                  <p>{item.title}</p>
                  <em>
                      {authorEntries && authorEntries.map((entry, idx) => (
                        <>
                          <AuthorName author={entry.data} />
                          {idx < authorEntries.length - 1 && '\t'}
                        </>
                      ))}
                  </em>
                </div>
              )
              })}
          </div>
        ))
      }
    </section>
  </div>
</StarlightPage>
